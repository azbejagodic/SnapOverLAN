{
  "name": "snap-over-lan",
  "version": "2.0.1",
  "description": "Local LAN photo transfer bridge between phone and PC",
  "repository": {
    "type": "git",
    "url": "https://github.com/azbejagodic/SnapOverLAN.git"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron app/main.js",
    "server": "node app/server/index.js",
    "desktop": "electron app/main.js",
    "app": "electron app/main.js",
    "dist": "npm run generate:icons && electron-builder --win --publish never",
    "package:extension": "node scripts/package-extension.mjs",
    "release:build": "npm run dist && npm run package:extension",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:pwa-connection": "node --test tests/pwa-connection.test.mjs",
    "test:electron-controls": "node --test tests/electron-server-controls.test.mjs tests/auto-copy.test.mjs",
    "test:electron-clipboard-smoke": "node scripts/run-electron-auto-copy-smoke.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "libheif-js": "^1.23.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "build": {
    "appId": "local.snapoverlan.app",
    "productName": "SnapOverLAN",
    "publish": [
      {
        "provider": "github",
        "owner": "azbejagodic",
        "repo": "SnapOverLAN"
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets/electron"
    },
    "files": [
      "app/**/*",
      "pwa/**/*",
      "extension/**/*",
      "assets/**/*",
      "package.json",
      "!data/**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.log"
    ],
    "win": {
      "icon": "assets/electron/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/electron/app.icns"
    },
    "linux": {
      "icon": "assets/electron"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapOverLAN",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
